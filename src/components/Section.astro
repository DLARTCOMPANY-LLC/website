---
interface Props {
  id: string;
  /** Alternating tone keeps adjacent sections from blending together. */
  tone?: 'base' | 'raised';
  class?: string;
}

const { id, tone = 'base', class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'relative scroll-mt-20 border-t border-ink-800/70 px-6 py-24 md:px-10 md:py-36',
    tone === 'raised' ? 'bg-ink-900' : 'bg-ink-950',
    className,
  ]}
>
  <div class="mx-auto max-w-6xl">
    <slot />
  </div>
</section>
