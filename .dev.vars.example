# Copy to .dev.vars for local Worker development. Never commit .dev.vars.
OPENAI_API_KEY=replace-with-a-local-development-key
OPENAI_VISION_MODEL=gpt-4.1-mini

# Native clients normally omit Origin. Add only trusted browser origins here.
CORS_ALLOWED_ORIGINS=http://localhost:4321

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS=4
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_OUTPUT_TOKENS=6000
