# Copy to .dev.vars for local Worker development. Never commit .dev.vars.
OPENAI_API_KEY=replace-with-a-local-development-key
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

# Native clients normally omit Origin. Add only trusted browser origins here.
CORS_ALLOWED_ORIGINS=http://localhost:4321

RATE_LIMIT_REQUESTS=10
GLOBAL_RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS=4
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_OUTPUT_TOKENS=10000
OPENAI_SPEECH_TIMEOUT_MS=30000

# Optional Google Gemini speech provider (off by default; OpenAI stays active).
# GEMINI_API_KEY is a secret; never commit it.
GEMINI_SPEECH_ENABLED=false
GEMINI_API_KEY=replace-with-a-local-development-key
GEMINI_SPEECH_MODEL=gemini-3.1-flash-tts-preview
GEMINI_LLM_MODEL=gemini-3.1-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_SPEECH_TIMEOUT_MS=30000
