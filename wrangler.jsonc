{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dlartcompany-screenplay-api",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "OPENAI_VISION_MODEL": "gpt-5.6-sol",
    "OPENAI_TTS_MODEL": "gpt-4o-mini-tts",
    "OPENAI_TTS_VOICE": "alloy",
    "OPENAI_TTS_FORMAT": "mp3",
    "OPENAI_TTS_TIMEOUT_MS": "30000",
    "OPENAI_TTS_MAX_OUTPUT_BYTES": "10485760",
    "MAX_CONCURRENT_TTS_REQUESTS": "2",
    "CORS_ALLOWED_ORIGINS": "",
    "RATE_LIMIT_REQUESTS": "10",
    "GLOBAL_RATE_LIMIT_REQUESTS": "100",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "MAX_CONCURRENT_REQUESTS": "4",
    "OPENAI_TIMEOUT_MS": "90000",
    "OPENAI_MAX_OUTPUT_TOKENS": "10000"
  }
}
